+// Machine admission reads must not wait for optional activity/time/link resources.
+async fn get_core_task(
+    requested: &str,
+    ctx: &ResolvedContext,
+    client: &ApiClient,
+) -> anyhow::Result<serde_json::Value> {
+    let expected_ref = parse_task_ref(requested);
+    let id = if let Some((slug, number)) = expected_ref {
+        let ws = crate::auth::require_workspace(ctx)?;
+        let result: serde_json::Value = client
+            .get_query(
+                "/search",
+                &[
+                    ("q", requested),
+                    ("workspaceId", ws),
+                    ("type", "tasks"),
+                    ("limit", "100"),
+                ],
+            )
+            .await?;
+        let rows = result
+            .get("results")
+            .or_else(|| result.get("tasks"))
+            .and_then(|x| x.as_array())
+            .ok_or_else(|| anyhow::anyhow!("invalid task search response"))?;
+        let total = result
+            .get("totalCount")
+            .and_then(|v| v.as_u64())
+            .ok_or_else(|| anyhow::anyhow!("missing search completeness count"))?;
+        anyhow::ensure!(
+            total == rows.len() as u64,
+            "incomplete task search response"
+        );
+        let ids: std::collections::BTreeSet<String> = rows
+            .iter()
+            .filter(|x| {
+                x.get("projectSlug").and_then(|v| v.as_str()) == Some(slug)
+                    && x.get("taskNumber")
+                        .or_else(|| x.get("number"))
+                        .and_then(|v| v.as_i64())
+                        == Some(number)
+                    && ctx
+                        .project_id
+                        .as_deref()
+                        .is_none_or(|p| x.get("projectId").and_then(|v| v.as_str()) == Some(p))
+            })
+            .filter_map(|x| {
+                x.get("id")
+                    .and_then(|v| v.as_str())
+                    .filter(|v| !v.is_empty())
+                    .map(String::from)
+            })
+            .collect();
+        anyhow::ensure!(
+            ids.len() == 1,
+            "core read requires one exact task search match"
+        );
+        ids.into_iter().next().unwrap()
+    } else {
+        requested.to_string()
+    };
+    anyhow::ensure!(
+        !id.is_empty() && !id.contains('/') && !id.contains('?') && !id.contains('#'),
+        "invalid task identity"
+    );
+    let task: Task = client.get(&format!("/task/{id}")).await?;
+    anyhow::ensure!(task.id == id, "task identity mismatch");
+    anyhow::ensure!(
+        ctx.project_id
+            .as_deref()
+            .is_none_or(|p| p == task.project_id),
+        "task project mismatch"
+    );
+    let project: crate::api::types::Project =
+        client.get(&format!("/project/{}", task.project_id)).await?;
+    anyhow::ensure!(
+        project.id == task.project_id && !project.slug.is_empty(),
+        "project identity mismatch"
+    );
+    anyhow::ensure!(
+        ctx.workspace_id
+            .as_deref()
+            .is_none_or(|w| w == project.workspace_id),
+        "workspace mismatch"
+    );
+    let number = task
+        .number
+        .ok_or_else(|| anyhow::anyhow!("missing task number"))?;
+    let task_ref = format!("{}-{number}", project.slug);
+    anyhow::ensure!(
+        expected_ref.is_none() || task_ref == requested,
+        "task ref mismatch"
+    );
+    let labels: Vec<Label> = client.get(&format!("/label/task/{id}")).await?;
+    anyhow::ensure!(
+        labels
+            .iter()
+            .all(|l| l.task_id.as_deref() == Some(id.as_str())
+                && l.workspace_id.as_deref() == Some(project.workspace_id.as_str())
+                && !l.name.is_empty()),
+        "label ownership or name mismatch"
+    );
+    let mut val = serde_json::to_value(task)?;
+    val["ref"] = serde_json::json!(task_ref);
+    val["labels"] = serde_json::json!(labels.iter().map(|l| &l.name).collect::<Vec<_>>());
+    Ok(val)
+}
