+  seen.clear();r=subprocess.run([binary,'task','get','task1' if mode=='opaque' else 'FAC-1','--core','--json'],cwd=cwd,env=env,capture_output=True,text=True,timeout=10)
+  assert (r.returncode==0)==(mode in ['ok','opaque']),(mode,r.returncode,r.stdout,r.stderr)
+  assert all(x.startswith('/api/search') or x in ['/api/task/task1','/api/project/project1','/api/label/task/task1'] for x in seen),seen
+  if mode in ['ok','opaque']:
