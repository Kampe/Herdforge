# Binaries and build output
bin/
*.out
.herd/coverage/
.herd/bootstrap/

# Local machine task provider link files
.kaneo.json
kaneo.json
.herd/kaneo.json
.herd/herd.yaml.local

# Coordinator-held receipt signing key (FAC-145) — never committed
.herd/receipt.key

# Launch receipt injected into agent worktrees at spawn (FAC-145) — runtime
# state, never committed; must not dirty worktree evidence
TASK-CONTEXT.json

# FAC-145 runtime authority state: published verification key, callback bus,
# and the approval intent journal
.herd/receipt.pub
.herd/mail.jsonl
.herd/mail.jsonl.*
# The live control mailbox is control-mail.jsonl; the mail.jsonl patterns above
# no longer match it, so its lock/seq/qmeta/ticket sidecars showed up untracked
# in every session and buried real changes in git status noise.
.herd/control-mail.jsonl
.herd/control-mail.jsonl.*
# board-audit's accepted-inherited baseline is deliberately TRACKED, not ignored:
# it decides which findings are historical, so a per-host copy would make the
# same audit disagree between operators and let a new bypass look inherited.

# Coordinator wind-down state and its lock (runtime, per-host).
.herd/winddown.json
.herd/winddown.json.lock
# Durable claim/lease store and evidence receipts (runtime, per-host).
.herd/claim/
.herd/receipts/
.herd/verification-receipts/
.herd/approve-intents.jsonl
.herd/approve-intents.lock

